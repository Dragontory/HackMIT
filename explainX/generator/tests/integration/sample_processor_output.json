    {
      "scene_id": "concept_002", 
      "title": "What is Linear Regression?",
      "duration_s": 60,
      "operations": [
        {
          "type": "text",
          "content": "Linear Regression",
          "position": "top",
          "style": {
            "font_size": 36,
            "text_color": "#2E86AB",
            "font_weight": "bold"
          }
        },
        {
          "type": "text",
          "content": "Linear regression is a statistical method used to model the relationship between a dependent variable and one or more independent variables.",
          "position": "center",
          "style": {
            "font_size": 20,
            "text_color": "#444444",
            "max_width": 800
          }
        },
        {
          "type": "text",
          "content": "Key Characteristics:",
          "position": "left",
          "style": {
            "font_size": 24,
            "text_color": "#A23B72",
            "font_weight": "bold"
          }
        },
        {
          "type": "list",
          "items": [
            "Assumes a linear relationship between variables",
            "Minimizes the sum of squared residuals",
            "Provides interpretable coefficients",
            "Foundation for more complex algorithms"
          ],
          "style": {
            "bullet_style": "•",
            "item_spacing": 8,
            "font_size": 18,
            "text_color": "#555555"
          }
        }
      ]
    },
    {
      "scene_id": "math_003",
      "title": "Mathematical Foundation",
      "duration_s": 75,
      "operations": [
        {
          "type": "text",
          "content": "The Linear Regression Equation",
          "position": "top",
          "style": {
            "font_size": 32,
            "text_color": "#2E86AB",
            "font_weight": "bold"
          }
        },
        {
          "type": "math",
          "expression": "y = \\beta_0 + \\beta_1 x_1 + \\beta_2 x_2 + ... + \\beta_n x_n + \\epsilon",
          "position": "center",
          "style": {
            "font_size": 28,
            "text_color": "#000000"
          }
        },
        {
          "type": "text",
          "content": "Where:",
          "position": "left",
          "style": {
            "font_size": 20,
            "text_color": "#A23B72",
            "font_weight": "bold"
          }
        },
        {
          "type": "list",
          "items": [
            "y = dependent variable (target)",
            "β₀ = y-intercept (bias term)",
            "β₁, β₂, ..., βₙ = coefficients (weights)",
            "x₁, x₂, ..., xₙ = independent variables (features)",
            "ε = error term (residual)"
          ],
          "style": {
            "bullet_style": "→",
            "item_spacing": 10,
            "font_size": 16,
            "text_color": "#444444"
          }
        }
      ]
    },
    {
      "scene_id": "cost_function_004",
      "title": "Cost Function",
      "duration_s": 90,
      "operations": [
        {
          "type": "text",
          "content": "Mean Squared Error (MSE)",
          "position": "top",
          "style": {
            "font_size": 32,
            "text_color": "#2E86AB",
            "font_weight": "bold"
          }
        },
        {
          "type": "text",
          "content": "Linear regression minimizes the Mean Squared Error to find the best-fitting line:",
          "position": "center",
          "style": {
            "font_size": 20,
            "text_color": "#444444"
          }
        },
        {
          "type": "math",
          "expression": "MSE = \\frac{1}{n} \\sum_{i=1}^{n} (y_i - \\hat{y_i})^2",
          "position": "center",
          "style": {
            "font_size": 32,
            "text_color": "#A23B72"
          }
        },
        {
          "type": "math",
          "expression": "\\hat{y_i} = \\beta_0 + \\beta_1 x_i",
          "position": "center",
          "style": {
            "font_size": 24,
            "text_color": "#000000"
          }
        },
        {
          "type": "text",
          "content": "The goal is to find β₀ and β₁ that minimize this cost function.",
          "position": "bottom",
          "style": {
            "font_size": 18,
            "text_color": "#666666",
            "style": "italic"
          }
        }
      ]
    },
    {
      "scene_id": "visualization_005",
      "title": "Data Visualization",
      "duration_s": 80,
      "operations": [
        {
          "type": "text",
          "content": "Sample Dataset: House Prices vs Size",
          "position": "top",
          "style": {
            "font_size": 28,
            "text_color": "#2E86AB",
            "font_weight": "bold"
          }
        },
        {
          "type": "graph2d",
          "title": "House Price Prediction",
          "x_label": "House Size (sq ft)",
          "y_label": "Price ($1000s)",
          "data": {
            "scatter": [
              [1200, 180], [1500, 230], [1800, 280], [2100, 320],
              [2400, 380], [2700, 420], [3000, 480], [3300, 520],
              [1300, 190], [1600, 240], [1900, 290], [2200, 340],
              [2500, 390], [2800, 440], [3100, 490], [3400, 540]
            ],
            "regression_line": {
              "slope": 0.15,
              "intercept": 50,
              "x_range": [1000, 3500]
            }
          },
          "style": {
            "point_color": "#A23B72",
