            "point_size": 8,
            "grid": true,
            "grid_color": "#E0E0E0"
          }
        }
      ]
    },
    {
      "scene_id": "gradient_descent_006",
      "title": "Gradient Descent Algorithm",
      "duration_s": 95,
      "operations": [
        {
          "type": "text",
          "content": "Gradient Descent Optimization",
          "position": "top",
          "style": {
            "font_size": 32,
            "text_color": "#2E86AB",
            "font_weight": "bold"
          }
        },
        {
          "type": "text",
          "content": "Iterative algorithm to find optimal parameters:",
          "position": "center",
          "style": {
            "font_size": 20,
            "text_color": "#444444"
          }
        },
        {
          "type": "math",
          "expression": "\\beta_0 := \\beta_0 - \\alpha \\frac{\\partial MSE}{\\partial \\beta_0}",
          "position": "center",
          "style": {
            "font_size": 24,
            "text_color": "#A23B72"
          }
        },
        {
          "type": "math", 
          "expression": "\\beta_1 := \\beta_1 - \\alpha \\frac{\\partial MSE}{\\partial \\beta_1}",
          "position": "center",
          "style": {
            "font_size": 24,
            "text_color": "#A23B72"
          }
        },
        {
          "type": "text",
          "content": "Where α is the learning rate",
          "position": "bottom",
          "style": {
            "font_size": 18,
            "text_color": "#666666"
          }
        },
        {
          "type": "list",
          "items": [
            "Initialize parameters randomly",
            "Calculate cost function",
            "Compute gradients",
            "Update parameters",
            "Repeat until convergence"
          ],
          "style": {
            "bullet_style": "1.",
            "item_spacing": 8,
            "font_size": 16,
            "text_color": "#555555"
          }
        }
      ]
    },
    {
      "scene_id": "evaluation_007",
      "title": "Model Evaluation Metrics",
      "duration_s": 70,
      "operations": [
        {
          "type": "text",
          "content": "Evaluating Linear Regression Performance",
          "position": "top",
          "style": {
            "font_size": 28,
            "text_color": "#2E86AB",
            "font_weight": "bold"
          }
        },
        {
          "type": "text",
          "content": "R-squared (Coefficient of Determination):",
          "position": "left",
          "style": {
            "font_size": 22,
            "text_color": "#A23B72",
            "font_weight": "bold"
          }
        },
        {
          "type": "math",
          "expression": "R^2 = 1 - \\frac{SS_{res}}{SS_{tot}} = 1 - \\frac{\\sum(y_i - \\hat{y_i})^2}{\\sum(y_i - \\bar{y})^2}",
          "position": "center",
          "style": {
            "font_size": 20,
            "text_color": "#000000"
          }
        },
        {
          "type": "list",
          "items": [
            "R² = 1.0: Perfect fit",
            "R² = 0.8: Good fit (80% variance explained)",
            "R² = 0.5: Moderate fit",
            "R² = 0.0: No linear relationship",
            "R² < 0.0: Model worse than baseline"
          ],
          "style": {
            "bullet_style": "▶",
            "item_spacing": 8,
            "font_size": 16,
            "text_color": "#444444"
          }
        }
      ]
    },
